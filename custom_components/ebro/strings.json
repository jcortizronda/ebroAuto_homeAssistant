{
  "config": {
    "step": {
      "user": {
        "title": "Ebro Auto",
        "description": "Introduce el teléfono y la contraseña de tu cuenta Ebro, y el PIN del vehículo. El VIN y el ID de cuenta se detectan solos. La sesión se renueva sola.{reason}",
        "data": {
          "phone": "Teléfono de la cuenta",
          "password": "Contraseña",
          "pin": "PIN del vehículo (comandos)",
          "area_code": "Prefijo de país (ej. 34)",
          "bff": "BFF endpoint (avanzado)",
          "tsp_host": "TSP host (avanzado)",
          "car_mqtt_host": "Broker MQTT (avanzado)",
          "car_mqtt_port": "Puerto MQTT (avanzado)",
          "channel_id": "Channel ID (avanzado)",
          "certs_src": "Carpeta de certificados mutual-TLS (opcional)"
        }
      },
      "select_vehicle": {
        "title": "Select vehicle",
        "description": "Your account has more than one vehicle. Choose the VIN to add.",
        "data": {
          "vin": "Vehicle (VIN)"
        }
      },
      "poll": {
        "title": "Ebro Auto — polling intervals",
        "description": "How often to refresh telemetry (battery, range, high voltage, charging…) depending on the car's state. Read-only. 0 = disabled in that state. You can keep the defaults and change them later in Options.",
        "data": {
          "poll_normal_min": "Parked (minutes, 0 = don't contact the car)",
          "poll_plugged_min": "Plugged in, waiting to charge (minutes, 0 = off)",
          "poll_charging_min": "Charging (minutes, 0 = off)",
          "poll_moving_min": "Driving (minutes, 0 = off)",
          "poll_moving_idle_min": "Driving but stopped — HV on, no movement (minutes, 0 = off)",
          "plugged_wait_max_min": "Max plugged-in without charging (minutes, 0 = no limit)"
        }
      },
      "reconfigure": {
        "title": "Change the vehicle control PIN",
        "description": "Enter the 4-digit PIN used for remote commands. The PIN is not used to log in, so no email code is needed. Fix this if commands report success but the car does nothing (wrong PIN).",
        "data": {
          "pin": "Vehicle control PIN"
        }
      },
      "reauth_confirm": {
        "title": "Ebro Auto — reautenticar",
        "description": "La sesión ({phone}) ha caducado. Introduce la contraseña para volver a entrar.{reason}",
        "data": {
          "password": "Contraseña"
        }
      }
    },
    "error": {
      "login_failed": "Login fallido. Revisa teléfono/contraseña.",
      "no_vehicle": "Login OK pero no se encontró ningún vehículo.",
      "token_move_failed": "No se pudo guardar el token.",
      "pin_required": "El PIN es obligatorio."
    },
    "abort": {
      "already_configured": "This vehicle (VIN) is already configured.",
      "token_move_failed": "Could not store the authentication token. Check Home Assistant's config folder permissions and try again.",
      "reconfigure_no_entry": "Integration not found — reload Home Assistant and try again.",
      "reconfigure_successful": "PIN updated. The integration was reloaded.",
      "reauth_no_entry": "Integration not found — reload Home Assistant and try again.",
      "reauth_successful": "Re-authentication successful. The integration was reloaded."
    }
  },
  "issues": {
    "pin_wrong": {
      "title": "Ebro Auto: wrong command PIN",
      "fix_flow": {
        "step": {
          "pin": {
            "title": "Fix the vehicle control PIN",
            "description": "Remote commands are being rejected because the 4-digit control PIN is wrong (the sensors keep working — this is not a login problem). Enter the correct PIN. Do not keep retrying with a wrong PIN, to avoid locking the Chery account.",
            "data": {
              "pin": "Vehicle control PIN"
            }
          }
        },
        "error": {
          "pin_required": "Enter the vehicle control PIN."
        },
        "abort": {
          "entry_not_found": "Integration not found — reload Home Assistant and try again."
        }
      }
    }
  },
